rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Board cards, links and replies. Text fields arrive already encrypted by the page.
    match /boards/{module}/{kind}/{id} {
      allow read: if module.matches('m[1-9]') && kind in ['nodes', 'links', 'replies'];
      allow write: if module.matches('m[1-9]') && kind in ['nodes', 'links', 'replies']
                   && (request.resource == null || request.resource.size() <= 400000);
    }
    // Display names (encrypted).
    match /people/{uid} {
      allow read: if true;
      allow write: if request.resource == null || request.resource.data.keys().hasOnly(['name_ct', 'at']);
    }
  }
}
